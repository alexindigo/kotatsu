<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <application>
        <service android:name="com.alexindigo.kotatsu.fakesyncadapter.AccountService" android:exported="true" android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/account" />
        </service>
        <service android:name="com.alexindigo.kotatsu.fakesyncadapter.ContactsSyncService" android:exported="true" android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter><action android:name="android.content.SyncAdapter" /></intent-filter>
            <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/contacts_sync" />
        </service>
        <service android:name="com.alexindigo.kotatsu.fakesyncadapter.CalendarSyncService" android:exported="true" android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter><action android:name="android.content.SyncAdapter" /></intent-filter>
            <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/calendar_sync" />
        </service>
        <receiver android:name="com.alexindigo.kotatsu.fakesyncadapter.FixtureReceiver" android:exported="true" />
    </application>
</manifest>
