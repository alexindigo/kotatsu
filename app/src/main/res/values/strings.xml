    <string name="sort_latest_top">Latest on top</string>
    <string name="sort_oldest_top">Oldest on top</string>
    <string name="lockscreen_reenable_message">Accessibility access gets turned off when the app is updated. Enable it again to keep using the features that need it.</string>
    <string name="a11y_setup_title">Turn on Kotatsu Action Service</string>
    <string name="a11y_setup_reason">This feature runs through the Kotatsu Action Service. Android lists it under Accessibility.</string>
    <string name="a11y_setup_step_open">1. Tap Kotatsu Action Service.</string>
    <string name="a11y_setup_step_use">2. Turn on Use Kotatsu Action Service and allow it.</string>
    <string name="a11y_setup_step_shortcut">3. Leave Kotatsu Action Service shortcut off. It adds a floating button to every screen.</string>
    <string name="a11y_setup_open">Open Accessibility settings</string>
    <string name="lockscreen_reenable_disable">Turn off these features</string>
    <string name="lockscreen_readme_privacy">This feature draws over the lock screen using an accessibility overlay. That permission sounds scary, but Kotatsu uses it only to display the widget and to read the lock screen itself, never your apps, so the widget can hide when the PIN screen appears. Nothing is recorded or shared; the open source code is the proof.</string>
    <string name="lockscreen_readme_usage">Long-press the widget to adjust it: drag to move, drag the handle below it to resize. Tap it once to save and finish.</string>
