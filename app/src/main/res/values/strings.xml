    <string name="a11y_service_label">Kotatsu Action Service</string>
    <string name="a11y_shortcut_warning">In accessibility settings, turn on only the Kotatsu Action Service itself, not its shortcut. The shortcut adds a floating accessibility button to your screen.</string>
    <string name="lockscreen_widget_a11y_desc">Used for the lock-screen box and its widgets, lock-screen notifications, music and weather, covering the status bar clock, locking the phone, and the screensaver. Draws only over the lock screen and status bar; reads nothing from your apps.</string>
    <string name="lockscreen_widget_apps">Lock screen notification apps</string>
    <string name="lockscreen_widget_apps_desc">Choose which apps appear on the lock screen widget</string>
    <string name="lockscreen_message">Lock screen message</string>
    <string name="lockscreen_message_desc">Your own text at the bottom of the lock screen</string>
