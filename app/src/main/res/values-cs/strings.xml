    <string name="lockscreen_reenable_message">Přístup k usnadnění přístupu se při aktualizaci aplikace vypne. Povolte jej znovu, aby funkce, které jej potřebují, dál fungovaly.</string>
    <string name="a11y_setup_title">Zapnout Kotatsu Action Service</string>
    <string name="a11y_setup_reason">Tato funkce běží přes Kotatsu Action Service. Android ji uvádí v Přístupnosti.</string>
    <string name="a11y_setup_step_open">1. Klepněte na Kotatsu Action Service.</string>
