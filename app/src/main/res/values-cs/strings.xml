    <string name="a11y_service_label">Kotatsu Action Service</string>
    <string name="a11y_shortcut_warning">V nastavení přístupnosti zapněte pouze samotnou službu Kotatsu Action Service, ne její zkratku. Zkratka přidá na obrazovku plovoucí tlačítko přístupnosti.</string>
    <string name="lockscreen_widget_a11y_desc">Používá se pro rámeček a widgety na zamykací obrazovce, oznámení, hudbu a počasí na zamykací obrazovce, zakrytí hodin stavového řádku, zamknutí telefonu a spořič. Kreslí pouze přes zamykací obrazovku a stavový řádek; z vašich aplikací nic nečte.</string>
