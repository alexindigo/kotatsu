<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Add current location": a one-off fix while the setup screen is open, never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_kotatsu_weather"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" android:allowBackup="false"
        android:supportsRtl="true">
        <receiver android:name=".WeatherWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.alexindigo.kotatsu.weather.REFRESH" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_widget" />
        </receiver>
        <!-- Widget-bound editors and fresh app-icon routing have different lifetimes. -->
        <activity android:name=".ConfigureActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".WeatherEntryActivity" android:exported="true"
            android:taskAffinity="" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".RefreshJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    </application>
</manifest>
