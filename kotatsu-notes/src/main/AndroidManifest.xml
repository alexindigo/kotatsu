<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.mudita.data.provider.permission.READ_NOTES" />
    <uses-permission android:name="com.mudita.data.provider.permission.WRITE_NOTES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries><provider android:authorities="com.mudita.notes" /></queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_kotatsu_notes"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" android:allowBackup="false"
        android:supportsRtl="true">
        <receiver android:name=".NotesWidgetProvider" android:exported="true" android:directBootAware="true"
            android:enabled="@bool/widget_supported" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/notes_widget" />
        </receiver>
        <activity android:name=".ConfigureActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".NotesEntryActivity" android:exported="true" android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".NotesChangedJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    </application>
</manifest>
