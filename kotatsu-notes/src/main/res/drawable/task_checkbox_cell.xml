    android:insetLeft="@dimen/task_button_padding" android:insetRight="@dimen/task_button_padding"
    android:insetBottom="@dimen/task_button_padding">
    <inset android:drawable="@drawable/task_checkbox" android:insetBottom="@dimen/task_button_padding" />
</inset>
