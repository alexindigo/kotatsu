<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote_paper" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="bottom" android:background="#FFFFFF">
    <TextView android:id="@+id/quote_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="lato-mudita" android:textColor="#000000" android:breakStrategy="simple"
        android:hyphenationFrequency="none" android:textSize="24sp" />
    <FrameLayout android:id="@+id/quote_author_slot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
