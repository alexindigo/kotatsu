<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#FFFFFF" android:paddingStart="@dimen/task_row_start" android:paddingEnd="16dp">
    <LinearLayout android:id="@+id/task_content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="top" android:baselineAligned="true" android:paddingBottom="@dimen/task_row_padding">
    <CheckBox android:id="@+id/task_check" android:layout_width="wrap_content" android:layout_height="wrap_content"
        style="@style/NotesWidgetTask" android:button="@drawable/task_checkbox_cell" android:buttonTint="@null" android:background="@null"
        android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"
        android:gravity="top|start" android:focusable="false" />
    <TextView android:id="@+id/task_text" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" style="@style/NotesWidgetTask"
        android:paddingBottom="@dimen/task_button_padding" android:paddingStart="0dp" android:paddingEnd="8dp" android:importantForAccessibility="no" />
    </LinearLayout>
    <FrameLayout android:id="@+id/task_gap" android:layout_width="1dp" android:layout_height="@dimen/task_row_padding" />
</LinearLayout>
